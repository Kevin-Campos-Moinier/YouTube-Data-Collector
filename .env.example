# Copy to ~/.config/smdc/.env (Windows: %APPDATA%\smdc\.env; SMDC_ENV overrides) — never into a synced
# or shared folder, never into git. Get a key: Google Cloud Console > APIs & Services >
# enable "YouTube Data API v3" > Credentials > Create credentials > API key.
YOUTUBE_API_KEY=
# Optional: pseudonymization secret. If empty, one is generated in the data folder (.secret).
# Set the same value on every computer (before the first run) to get identical author keys.
# Share it only with people allowed to re-identify commenters.
SMDC_SECRET=
